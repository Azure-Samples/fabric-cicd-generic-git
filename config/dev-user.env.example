# User-token auth mode (az cli).
# Use this template when you cannot create a service principal in the target tenant.
# Authenticate first with: az login --tenant <your-tenant-id>
#
# FABRIC_AUTH_MODE=azcli forces Azure CLI auth even if FABRIC_CLIENT_SECRET is
# present in the environment (e.g., inherited from a parent shell).

FABRIC_AUTH_MODE=azcli
FABRIC_TENANT_ID="<your-tenant-id>"
FABRIC_WORKSPACE_NAME="<target-workspace-name>"

# Optional: capacity ID for create_workspace.sh
# FABRIC_CAPACITY_ID="<capacity-id>"
