# Test environment configuration.
# Copy to test.env and fill in real values. test.env is gitignored.
# In CI/CD (e.g., GitLab CI), set these as environment-scoped variables instead of a file.
# This environment may live in a different Microsoft Entra tenant than dev.

# Microsoft Entra tenant that hosts this environment's Fabric capacity.
FABRIC_TENANT_ID="00000000-0000-0000-0000-000000000000"

# Service principal (app registration) client ID.
FABRIC_CLIENT_ID="00000000-0000-0000-0000-000000000000"

# Service principal client secret. Never commit the real value.
FABRIC_CLIENT_SECRET="replace-with-client-secret"

# Target workspace display name.
FABRIC_WORKSPACE_NAME="bulk-test"

# Capacity ID used when creating the workspace (optional; create_workspace.sh).
FABRIC_CAPACITY_ID="00000000-0000-0000-0000-000000000000"

# Fabric API base URL. Override only for sovereign clouds.
FABRIC_API_BASE_URL="https://api.fabric.microsoft.com/v1"

# Microsoft Entra authority host. Override only for sovereign clouds.
FABRIC_AUTHORITY_HOST="https://login.microsoftonline.com"
